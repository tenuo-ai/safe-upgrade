# Copy to .env and fill in. .env is gitignored.
#
# Nothing here is read from graph state, prompts, reports, patches, or CI files.
# Secrets reach the system through runtime configuration only.

# Jev decision engine. Without it the deterministic fallback handles all routing.
TYPESAFE_API_KEY=
# Optional: defaults to jev-latest.
TYPESAFE_DEFAULT_MODEL=

# Tenuo production authorization. Development runs mint their own root instead.
# Hex public key of the trusted issuer.
TENUO_ROOT_PUBLIC_KEY=
# Warrant minted by that issuer for this run.
TENUO_RUN_WARRANT=
# This holder's 32-byte secret, hex encoded.
TENUO_RUN_HOLDER_SECRET=

# Code and test generation. Separate from the decision engine by design.
OPENAI_API_KEY=

# Draft pull request creation. Needs pull-request write on the target repository.
GITHUB_TOKEN=

# Isolated execution sandbox.
E2B_API_KEY=
